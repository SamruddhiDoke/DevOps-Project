# Full portfolio deployment: EKS (2 nodes) + RDS + Jenkins EC2 + monitoring.
#   terraform plan -var-file=environments/full.tfvars
# No secrets here: the RDS password is generated by Terraform into Secrets Manager; TF_VAR_alert_email is optional.
# Replace the documentation CIDR below with your own public IP (curl https://checkip.amazonaws.com).
admin_cidr_blocks     = ["203.0.113.10/32"]
create_jenkins        = true
node_desired_size     = 2
node_min_size         = 1
node_max_size         = 3
jenkins_instance_type = "t3.large" # Jenkins + SonarQube on one host
monthly_budget_usd    = 350
