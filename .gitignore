# =========================================================
# IDE / Editor
# =========================================================
.idea/
.vscode/
*.iml
.claude/settings.local.json

# =========================================================
# OS
# =========================================================
.DS_Store
Thumbs.db

# =========================================================
# Environment / Secrets
# =========================================================
.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.jks

# Spring Boot local config
**/application-local.properties
**/application-local.yml

# =========================================================
# Node / React / Vite
# =========================================================
**/node_modules/
**/frontend/dist/
**/frontend/.vite/
**/frontend/coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================================
# Java / Maven / Spring Boot
# =========================================================
**/backend/target/
*.class

# =========================================================
# Terraform
# =========================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.exe

# Terraform variable files may contain secrets.
# terraform.tfvars in this repo holds only non-sensitive network/region values;
# secrets (db_password, alert_email) are passed via TF_VAR_* environment variables.
*.tfvars
*.tfvars.json
!terraform/terraform.tfvars
!terraform/environments/*.tfvars
!*.tfvars.example
backend.hcl

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# =========================================================
# Logs / temporary files
# =========================================================
*.log
*.tmp
*.temp

# Deploy state written by scripts/deploy-k8s.sh
.deploy/

# CI reports and local CI secrets
reports/
ci/.env
