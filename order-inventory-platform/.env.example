# Copy to .env (git-ignored) and change the values. Used by docker-compose.yml.

# MySQL root password (only applied when the data volume is first created)
MYSQL_ROOT_PASSWORD=change-me-root

# Application database account used by the backend (least privilege)
DB_USER=inventory
DB_PASSWORD=change-me-app

# Host ports (change if they collide with other local services)
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Image tag for locally built images
IMAGE_TAG=local

